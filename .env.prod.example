# ===== 临时演示生产配置（复制为 .env.prod 后修改；.env.* 永不入库）=====
# 随机值生成：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"   # POSTGRES_PASSWORD

# 演示保持 development：SMTP 留空时验证码走 api 容器日志（正式对外必须
# 改 production 并配好 SMTP——生产环境启动校验会拒绝弱密钥/缺盐值）
ENVIRONMENT=development
SECRET_KEY=change-me-random-at-least-32-chars
# 同源反代（caddy），前端生产无 CORS 需求 → 留空
CORS_ORIGINS=

# ===== 数据库（容器网络互访，主机名固定 postgres）=====
# 注意：DATABASE_URL 里的密码必须与 POSTGRES_PASSWORD 完全一致
POSTGRES_USER=pd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pd
DATABASE_URL=postgresql+psycopg://pd:change-me@postgres:5432/pd

# ===== 上游 CPS（临时演示走本地数据导入：凭据留空 → 同步调度自动不跑，
# 分类口径零改动；要跑真实同步时再填） =====
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=

# ===== 订单分类盐值（必填！迁移 0003 回填启动校验；空库回填零行无副作用）=====
# 从本机 backend/.env 复制同一盐值，保证与本机数据的 tag 判定一致
ORDER_FILTER_SALT=

# ===== HTTPS（可选）=====
# 留空 = 纯 HTTP :80（裸 IP 访问，临时演示默认）
# 境外服务器可填 sslip.io 形式域名（IP 1.2.3.4 → 1-2-3-4.sslip.io）= 自动 HTTPS；
# 大陆服务器该域名可能被未备案拦截 → 改用 tunnel profile（见部署文档 §HTTPS）
SITE_ADDRESS=
