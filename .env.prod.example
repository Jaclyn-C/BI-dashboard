# .env.prod.example — 生产配置模板（部署流程见 docs/deployment/按量开关部署手册.md §3）
#
# deploy/setup-server.sh 首次部署时自动复制为服务器上的 .env，并自动生成下面
# 三个随机值（生成后不可更换，尤其 ORDER_FILTER_SALT）：
#   SECRET_KEY / ORDER_FILTER_SALT / POSTGRES_PASSWORD
# 需要手动填的只有：DOMAIN、SMTP_*（发验证码）、UPSTREAM_CLIENT_*（同步上游订单）。
# 其余配置项（同步频率、分成比例等）走 app/config.py 内置默认值，与 .env.example 一致。

# ===== 必填：你的域名（Caddy 用它签 HTTPS 证书；DNS 先解析到服务器 IP）=====
DOMAIN=example.com

# ===== 应用（SECRET_KEY / ORDER_FILTER_SALT / POSTGRES_PASSWORD 由脚本生成）=====
ENVIRONMENT=production
SECRET_KEY=
ORDER_FILTER_SALT=
POSTGRES_PASSWORD=
# 生产同源部署（前端与 API 同域），CORS 白名单收紧为空
CORS_ORIGINS=

# ===== SMTP：发注册/登录验证码（不配则任何人都无法注册登录）=====
# 用 QQ/163 邮箱授权码：HOST=smtp.qq.com 或 smtp.163.com，PORT=465，SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_SSL=true

# ===== 上游 CPS（不配则订单同步不启动，看板无数据）=====
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=

# 同步调度开关（默认 true，30 分钟一轮 + 首次启动回填 92 天）
SYNC_ENABLED=true
