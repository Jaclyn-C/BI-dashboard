# ===== 应用 =====
# development | production（production 时未配 SMTP 不允许日志降级，见 DESIGN §6.4）
ENVIRONMENT=development
# JWT 签名密钥（>=32 随机字符；同时派生验证码 HMAC 密钥）。生成示例：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
# access token 有效期（分钟），Q6 定稿 8 小时
ACCESS_TOKEN_TTL_MINUTES=480
# CORS 白名单（逗号分隔；dev 用 Vite 端口，生产同源反代后收紧为空）
CORS_ORIGINS=http://localhost:5173

# ===== 数据库（PostgreSQL 16，dev 库见仓库根 compose.dev.yaml）=====
DATABASE_URL=postgresql+psycopg://pd:pd@localhost:5432/pd
# pytest 集成测试库（不进 Settings，由 tests/conftest.py 读取）
TEST_DATABASE_URL=postgresql+psycopg://pd:pd@localhost:5432/pd_test

# ===== 认证：验证码（REQ-20261012-01，Q2/Q3/Q4 定稿默认值）=====
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_COOLDOWN_SECONDS=60
CODE_HOURLY_LIMIT=5

# ===== 认证：SMTP（发件账号由用户提供；HOST 留空且 ENVIRONMENT=development 时验证码走日志降级）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ===== TFC 后端 API（仅 Phase 0 数据记录器临时使用，运行时禁止依赖） =====
TFC_API_BASE=https://api.tfctechnology.com
TFC_API_USERNAME=
TFC_API_PASSWORD=

# ===== 上游 CPS API（全量订单，OAuth2 client credentials，A1 接入时启用） =====
UPSTREAM_BASE=https://adminapi.netshort.com/prod-api/cps
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=
