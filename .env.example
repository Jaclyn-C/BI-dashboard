# ===== 应用 =====
# development | production（production 时未配 SMTP 不允许日志降级，见 DESIGN §6.4）
ENVIRONMENT=development
# JWT 签名密钥（>=32 随机字符；同时派生验证码 HMAC 密钥）。生成示例：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
# 唯一超管邮箱（REQ-20261020-01）：启动时自动提权；必须与已注册账号一致
# SUPER_ADMIN_EMAIL=owner@example.com
# access token 有效期（分钟），Q6 定稿 8 小时
ACCESS_TOKEN_TTL_MINUTES=480
# CORS 白名单（逗号分隔；dev 用 Vite 端口，生产同源反代后收紧为空）
CORS_ORIGINS=http://localhost:5173

# ===== 数据库（PostgreSQL 16，dev 库见仓库根 compose.dev.yaml）=====
DATABASE_URL=postgresql+psycopg://pd:pd@localhost:5432/pd
# pytest 集成测试库（不进 Settings，由 tests/conftest.py 读取）
TEST_DATABASE_URL=postgresql+psycopg://pd:pd@localhost:5432/pd_test

# ===== 认证：验证码（REQ-20261012-01，Q2/Q3/Q4 定稿默认值）=====
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_COOLDOWN_SECONDS=60
CODE_HOURLY_LIMIT=5

# ===== 认证：SMTP（发件账号由用户提供；HOST 留空且 ENVIRONMENT=development 时验证码走日志降级）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# 隐式 SSL（465 端口，163/QQ 邮箱用）；STARTTLS(587) 保持 false
SMTP_SSL=false
# ===== TFC 后端 API（仅 Phase 0 数据记录器临时使用，运行时禁止依赖） =====
TFC_API_BASE=https://api.tfctechnology.com
TFC_API_USERNAME=
TFC_API_PASSWORD=

# ===== 上游 CPS API（全量订单，OAuth2 client credentials，REQ-20261012-02 A1） =====
# 测试环境 base：https://adminapi.test.netshort.net/test-api/cps
UPSTREAM_BASE=https://adminapi.netshort.com/prod-api/cps
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=
# 拉取参数（D10 默认：页大小 / 时间窗二分最大深度 / 最小窗口秒 / 日窗并发 / 请求超时秒）
UPSTREAM_PAGE_SIZE=1000
UPSTREAM_MAX_SPLIT_DEPTH=6
UPSTREAM_MIN_SPLIT_WINDOW_SECONDS=120
UPSTREAM_CONCURRENCY=4
UPSTREAM_TIMEOUT_SECONDS=30

# ===== 同步调度（REQ-20261012-02 D1/D2/D3；测试与本地开发可关） =====
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_LOOKBACK_DAYS=3
SYNC_BACKFILL_DAYS=92

# ===== 订单过滤与分成（REQ-20261014-01，B1 已由业务重定义解除） =====
# 哈希打标盐值：sha256(salt:order_no) 前 8 位十六进制 → [0,1)，< keep_ratio → 已计入(included)
# 私密！只存 .env，不入库/不入代码/不泄露下游；一经使用不可更换（更换后新订单判定与存量 tag 不一致）
# 生成：openssl rand -hex 12
ORDER_FILTER_SALT=
# 保留比例（约 80% 订单计为已计入下发供应商）
ORDER_KEEP_RATIO=0.8
# 你的上游分成比例（全部订单原金额 × 70%）
UPSTREAM_SHARE_RATIO=0.70
# 供应商分成比例（已计入订单原金额 × 50%）
SUPPLIER_SHARE_RATIO=0.50
# ⚠️ 修改比例后需同步修改前端 i18n 文案中的 70%/50% 字样（en.json/zh.json，卡片标题与副标题）
